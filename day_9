class Solution {
public:
    int smallestIndex(vector<int>& nums) {

    int sum = 0;
        for(int i = 0 ; i < nums.size() ; i++){

      int n = nums[i];
            int sum = 0;

            while (n > 0) {
                sum += n % 10;
                n = n / 10;
            }
              if(i==sum){
                return i;
            }


         }
          
        
        return -1;
        
    }
};