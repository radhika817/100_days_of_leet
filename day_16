
class Solution {
public:
    int findTheDistanceValue(vector<int>& arr1, vector<int>& arr2, int d) {  
        int count = 0;
        for(int i = 0; i < arr1.size(); i++) {          
            bool valid = true;
            for(int j = 0; j < arr2.size(); j++) {
                
                int q = abs(arr1[i] - arr2[j]);

                if(q <= d) {
                    valid = false;
                    break;
                }
            }

            if(valid) {
                count++;
            }
        }

        return count;
    }
};


