today started with linked list
 
 for cycle detectionor finding midlle elememrnt we can use flyod algorithm in which we take two pointer = head and then slow m= slow ->next and fast = fast ->next->next

 class Solution {
public:
    bool hasCycle(ListNode *head) {
        ListNode* slow = head;
        ListNode* fast = head;
        while (fast != NULL && fast->next != NULL) {
            slow = slow->next;          
            fast = fast->next->next;   
            if (slow == fast) {
                return true;
           }
        }
        return false;
    }
};

