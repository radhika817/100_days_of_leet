class Solution {
public:
    bool isRectangleOverlap(vector<int>& rec1, vector<int>& rec2) {

        if (rec1[2] <= rec2[0] ||
            rec2[2] <= rec1[0] ||
            rec1[3] <= rec2[1] ||
            rec2[3] <= rec1[1]) {
            return false;
        }

        return true;
    }
};

class Solution {
public:
    int reverseDegree(string s) {
        int m = 0;
        for(int i = 0 ; i < s.size() ; i++){
          m += ('z' - s[i] + 1) * (i + 1);
        
        }return m;
    }
};