class Solution {
public:
    bool isSubsequence(string s, string t) {
        int k = 0;

        for(int i = 0; i < s.size(); i++) {
           

            for(int j = k; j < t.size(); j++) {
                if(s[i] == t[j]) {
                    k = j + 1;
                    
                    break;
                }
            }

   
                return false;
        }

        return true;
    }
};